{
  // ============================================================
  //  植物设定模板 —— 复制本文件为 <slug>.json 即可新增一种植物
  //  修改后重启服务或执行 seed 即生效(seed 幂等 upsert,不会丢数据)
  //  本文件带 _template 标记,不会被导入为植物
  // ============================================================

  "_template": true,

  // 唯一英文标识:素材目录名 / 种子道具 code 前缀 / 客户端取图都用它
  "slug": "rice",

  // 中文名:界面与种子道具显示
  "name": "水稻",

  // 分类:谷物 / 油料 / 蔬菜 / 经济作物 / 花卉(决定卖价倍率 category_factor)
  "category": "谷物",

  // 商店与作物列表排序(小在前)
  "sort_order": 1,

  // ---------- 宜种节气窗 ----------
  // type=term:start/end 为节气序号(1=立春 ... 24=大寒),grace=宽限轮次(窗口过后仍可种 N 个节气)
  // type=season:seasons 为季节名数组(春/夏/秋/冬),映射 春=1-6 夏=7-12 秋=13-18 冬=19-24
  "sow_window": { "type": "term", "start": 4, "end": 8, "grace": 1 },

  // 基础生长时长(秒),受加速季节影响
  "grow_seconds": 300,

  // 基础收成量(株),受土壤肥力加成:yield × (1 + 0.1 × (肥力-1))
  "yield_base": 6,

  // 基础收购单价(金币),卖价 = base × sell_factor × 季节倍率 × 分类倍率,且不超过 max_value
  "base_price": 20,

  // ---------- 解锁要求(播种时校验,达到其一即可) ----------
  "unlock_level": 1, // 需要的玩家等级(1-100);0 = 不限制
  "unlock_exp": 0,   // 需要的累计经验值;0 = 不限制

  // ---------- 高级设定 ----------
  "settings": {
    // 枯萎季节:玩家世界进入这些季节时,所有未收获的该作物立即枯萎(注意避开宜种窗)
    "wither_seasons": ["winter"],
    // 加速生长季节:在对应季节播种 → 该株生长速度 × 倍率(1.5 = 快 50%,成熟时间缩短)
    "fast_growth_seasons": { "summer": 1.5 },
    // 需水量:min 为生长红线 —— 有效水分低于它则生长停滞(水分随世界时间衰减,每节气 -10);
    // ideal 为满水参考(浇水补满到 100)
    "water_need": { "min": 50, "ideal": 80 },
    // 需肥力:地块土壤肥力低于该值 → 收成减产 ×(soil/need);等于或超过 → 无惩罚
    "fertility_need": 1,
    // 单株价值上限(金币):卖价 = min(公式价, 该值),防止极端季节/系数爆价;0 = 不封顶
    "max_value": 30
  },

  // 美术素材:省略时自动使用 /static/assets/crops/<slug>/{seed,1,2,3}.png
  // "art": { "seed": "...", "stages": ["...", "...", "..."] },

  // 备注(给策划/开发看)
  "note": "春播秋收,夏季加速,冬天枯萎"
}
