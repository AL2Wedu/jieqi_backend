{
  "images": {
    "root": "app/static/assets",
    "ext": ["png", "svg", "jpg", "webp"],
    "prerender": [32, 64, 128, 256],
    "url_template": "/v1/assets/images/{key}/{name}.{ext}?w={w}",
    "namespaces": {
      "crops": { "names": ["seed", "1", "2", "3"] },
      "terms": { "names": ["main"] },
      "animals": {
        "names": ["bear", "cat", "cat2", "chicken", "crow", "deer", "dog", "dog2",
                  "fox", "frog", "hedgehog", "horse", "mouse", "owl", "ox", "panda",
                  "penguin", "pig", "rabbit", "raccoon", "sheep", "sheep2", "squirrel",
                  "wolf"],
        "emotions": ["happy", "calm", "sad", "confused"]
      }
    }
  },
  "audio": {
    "root": "app/static/assets/audio",
    "ext": ["ogg", "mp3", "wav"],
    "prerender": [],
    "url_template": "/v1/assets/audio/{key}/{name}.{ext}"
  },
  "config": {
    "root": "app/static/assets/config",
    "ext": ["json"],
    "prerender": [],
    "url_template": "/v1/assets/config/{key}/{name}.{ext}"
  },
  "pests": {
    "root": "app/static/assets/pests",
    "ext": ["png"],
    "prerender": [],
    "url_template": "/v1/assets/pests/{key}/{name}.{ext}",
    "namespaces": {
      "main": { "names": ["蚜虫", "蝗虫", "螟虫", "菜青虫", "棉铃虫", "稻飞虱"] },
      "banner": { "names": ["大虫害开场横幅配图"] }
    }
  }
}
